diff --git a/python/tvm/ir/json_compact.py b/python/tvm/ir/json_compact.py
index 848de6b54dc2a836eb4669983fb9d009a1af212e..e9a1a6029038e0ce117651880c751fca9aef3825 100644
--- a/python/tvm/ir/json_compact.py
+++ b/python/tvm/ir/json_compact.py
@@ -84,4 +84,21 @@ def upgrade_json(json_str):
     data = json.loads(json_str)
     if "metadata" not in data and "attrs" in data:
         raise ValueError("Legacy json graph format detected, we don't support it anymore.")
+
+    # Older TileLang enums stored the name as a reference to an ffi.String node.
+    # TVM FFI 0.1.14 resolves the registered singleton from the name directly.
+    nodes = data.get("nodes", [])
+    for node in nodes:
+        if node.get("type") not in ("tl.SwizzleMode", "tl.WSSyncKind"):
+            continue
+        fields = node.get("data")
+        if isinstance(fields, dict) and "_name" in fields:
+            name_index = fields["_name"]
+            if type(name_index) is not int or not 0 <= name_index < len(nodes):
+                raise ValueError("Invalid enum name reference in the JSON graph.")
+            name_node = nodes[name_index]
+            if name_node.get("type") != "ffi.String" or not isinstance(name_node.get("data"), str):
+                raise ValueError("Invalid enum name in the JSON graph.")
+            node["data"] = name_node["data"]
+
     return json.dumps(data, indent=2)
